GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
GREENNODE_AGENT_IDENTITY=
# LLM provider config (any OpenAI-compatible provider)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# A small fast model for the routing classification; defaults to LLM_MODEL.
LLM_ROUTER_MODEL=
MEMORY_ID=
MEMORY_STRATEGY_ID=default

# Knowledge manager (single source of truth: mi-service retrieval endpoint)
KB_BACKEND=mi_service
MI_BASE_URL=
MI_TOKEN=
LOCALE=vi
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.72

# mi-service knowledge. MI_BASE_URL is the service root: the internal API is served at
# /internal/**, NOT under /api/v1/mi (that prefix requires a customer role and answers 403).
# The agent fetches its own mi:knowledge token with these; MI_TOKEN overrides for a quick probe.
MI_BASE_URL=http://mi-assistant-service:8080
KEYCLOAK_TOKEN_URI=http://keycloak:8080/auth/realms/msb/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=vrm-agent
KEYCLOAK_CLIENT_SECRET=
