# Keycloak (public client, Authorization Code + PKCE), realm msb — the customer realm, same one
# the mobile app's users log into. `msb-web` is a new client (infra/keycloak/realm-msb.json);
# re-run infra/keycloak/add-memory-scopes.sh-style kcadm commands or re-import the realm to pick
# it up on an existing Keycloak.
VITE_KEYCLOAK_URL=http://localhost:8180/auth
VITE_KEYCLOAK_REALM=msb
VITE_KEYCLOAK_CLIENT_ID=msb-web

# Where Vite proxies /api to. The gateway derives the customer identity from the JWT (see
# CustomerHeaderFilter) — no header here can assert it.
VITE_API_TARGET=http://localhost:8080
